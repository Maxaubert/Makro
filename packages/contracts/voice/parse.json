    {"id": "english-fifty", "input": {"text": "fifty grams of oats"}, "expected": {"items": [{"query": "oats", "quantity": 50, "unit": "g"}]}},
    {"id": "article-before-number", "input": {"text": "en tre-fire skiver ost"}, "expected": {"items": [{"query": "ost", "quantity": [3, 4], "unit": "piece"}]}},
    {"id": "compound-slice", "input": {"text": "en grovbrødskive med leverpostei"}, "expected": {"items": [{"query": "grovbrød", "quantity": 1, "unit": "piece"}, {"query": "leverpostei", "quantity": null, "unit": null}]}},
    {"id": "slices-each", "input": {"text": "to brødskiver med to skiver ost på hver"}, "expected": {"items": [{"query": "brød", "quantity": 2, "unit": "piece"}, {"query": "ost", "quantity": 2, "unit": "piece"}]}},
    {"id": "today", "input": {"text": "drakk en hel liter Yt proteinmelk i dag"}, "expected": {"items": [{"query": "yt proteinmelk", "quantity": 1000, "unit": "ml"}]}},
    {"id": "after-training", "input": {"text": "etter trening tok jeg en Barebells"}, "expected": {"items": [{"query": "barebells", "quantity": 1, "unit": "piece"}]}},
