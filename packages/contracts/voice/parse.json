    {"id": "logging-talk", "input": {"text": "skal bare legge inn frokost: to egg"}, "expected": {"items": [{"query": "egg", "quantity": 2, "unit": "piece"}]}},
    {"id": "size-words", "input": {"text": "en stor banan"}, "expected": {"items": [{"query": "banan", "quantity": 1, "unit": "piece"}]}},
    {"id": "handful", "input": {"text": "a handful of almonds"}, "expected": {"items": [{"query": "almonds", "quantity": 1, "unit": "serving"}]}},
