{
  "version": 1,
  "description": "Rule-based splitting of a spoken or typed food line (decision 49): the line becomes items, each with a search query, a quantity and a unit. No AI and no nutrition numbers: products are found afterwards by the normal search, and the user confirms. quantity is a number, a [low, high] range, or null when nothing was said. unit is g, ml, piece or serving (log_entries units), or null with a null quantity. dl, cl and litres become ml; kilos become g. A count with no unit, or an article (en, et, ei, a, an), is that many pieces. 'litt', 'a little', 'noe', 'some' with no amount is 1 serving. A clause that holds only an amount ('kanskje 100 gram') belongs to the item before it when that item had no amount. Chatter clauses are dropped.",
  "cases": [
    {"id": "two-eggs-and-mince", "input": {"text": "to egg og 200 g kjøttdeig"}, "expected": {"items": [{"query": "egg", "quantity": 2, "unit": "piece"}, {"query": "kjøttdeig", "quantity": 200, "unit": "g"}]}},
    {"id": "an-apple", "input": {"text": "et eple"}, "expected": {"items": [{"query": "eple", "quantity": 1, "unit": "piece"}]}},
    {"id": "digits-and-gram-word", "input": {"text": "150 gram skyr"}, "expected": {"items": [{"query": "skyr", "quantity": 150, "unit": "g"}]}},
    {"id": "amount-after-food", "input": {"text": "kylling 200 gram"}, "expected": {"items": [{"query": "kylling", "quantity": 200, "unit": "g"}]}},
    {"id": "decilitres-to-ml", "input": {"text": "2 dl melk"}, "expected": {"items": [{"query": "melk", "quantity": 200, "unit": "ml"}]}},
    {"id": "decimal-comma-litre", "input": {"text": "1,5 liter vann"}, "expected": {"items": [{"query": "vann", "quantity": 1500, "unit": "ml"}]}},
    {"id": "kilos-to-grams", "input": {"text": "0.5 kg poteter"}, "expected": {"items": [{"query": "poteter", "quantity": 500, "unit": "g"}]}},
    {"id": "range", "input": {"text": "10-15 gram smør"}, "expected": {"items": [{"query": "smør", "quantity": [10, 15], "unit": "g"}]}},
    {"id": "range-in-words", "input": {"text": "mellom 100 og 150 gram ris"}, "expected": {"items": [{"query": "ris", "quantity": [100, 150], "unit": "g"}]}},
    {"id": "about", "input": {"text": "rundt 75 gram proteinpulver"}, "expected": {"items": [{"query": "proteinpulver", "quantity": 75, "unit": "g"}]}},
    {"id": "number-words", "input": {"text": "tre skiver brød"}, "expected": {"items": [{"query": "brød", "quantity": 3, "unit": "piece"}]}},
    {"id": "half", "input": {"text": "en halv avokado"}, "expected": {"items": [{"query": "avokado", "quantity": 0.5, "unit": "piece"}]}},
    {"id": "a-cup-is-a-serving", "input": {"text": "en kopp kaffe"}, "expected": {"items": [{"query": "kaffe", "quantity": 1, "unit": "serving"}]}},
    {"id": "a-little", "input": {"text": "litt ketsjup"}, "expected": {"items": [{"query": "ketsjup", "quantity": 1, "unit": "serving"}]}},
    {"id": "no-amount", "input": {"text": "banan"}, "expected": {"items": [{"query": "banan", "quantity": null, "unit": null}]}},
    {"id": "brand-with-fra", "input": {"text": "en proteinbar fra Barebells"}, "expected": {"items": [{"query": "proteinbar barebells", "quantity": 1, "unit": "piece"}]}},
    {"id": "filler-and-meal-words", "input": {"text": "Til frokost hadde jeg et eple, og så tok jeg en yoghurt."}, "expected": {"items": [{"query": "eple", "quantity": 1, "unit": "piece"}, {"query": "yoghurt", "quantity": 1, "unit": "piece"}]}},
    {"id": "med-splits", "input": {"text": "200 gram kylling med litt ketsjup"}, "expected": {"items": [{"query": "kylling", "quantity": 200, "unit": "g"}, {"query": "ketsjup", "quantity": 1, "unit": "serving"}]}},
    {"id": "amount-only-clause-joins-before", "input": {"text": "litt grønnsaker, kanskje 100 gram"}, "expected": {"items": [{"query": "grønnsaker", "quantity": 100, "unit": "g"}]}},
