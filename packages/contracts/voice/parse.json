    {"id": "interjections", "input": {"text": "eh, jo, en banan"}, "expected": {"items": [{"query": "banan", "quantity": 1, "unit": "piece"}]}},
    {"id": "self-correction-nb", "input": {"text": "to egg, eller nei, tre egg"}, "expected": {"items": [{"query": "egg", "quantity": 3, "unit": "piece"}]}},
    {"id": "self-correction-en", "input": {"text": "a coffee, actually make that two coffees"}, "expected": {"items": [{"query": "coffees", "quantity": 2, "unit": "piece"}]}},
    {"id": "pronoun-pack-clause", "input": {"text": "en halv boks cottage cheese, den på 400 gram"}, "expected": {"items": [{"query": "cottage cheese", "quantity": 0.5, "unit": "piece"}]}},
