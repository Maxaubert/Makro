{
  "version": 1,
  "description": "End of day (#27). status compares the known kcal sum with the target: on_target from 90% to 110% inclusive, under below, over above. A day with no entries is not_logged: never treated as fasting, never under. A day whose entries all lack kcal is unknown. difference is eaten minus target. missing_values fires when any entry lacks kcal; few_entries, ended_early and long_gap fire only when the logged food does not already reach the target (status under, unknown or no_target). eaten_minutes is minutes after local midnight, null when not known. reasons keep this order: missing_values, few_entries, ended_early, long_gap.",
  "cases": [
    { "id": "not-logged-is-not-fasting", "input": { "entries": [], "kcal_target": 2400 }, "expected": { "status": "not_logged", "eaten": null, "covered": 0, "count": 0, "difference": null, "may_be_incomplete": false, "reasons": [] } },
    { "id": "canvas-under-and-stops-at-13-10", "input": { "entries": [{ "kcal": 800, "eaten_minutes": 480 }, { "kcal": 510, "eaten_minutes": 790 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1310, "covered": 2, "count": 2, "difference": -1090, "may_be_incomplete": true, "reasons": ["few_entries", "ended_early"] } },
    { "id": "under-but-looks-complete", "input": { "entries": [{ "kcal": 600, "eaten_minutes": 480 }, { "kcal": 700, "eaten_minutes": 780 }, { "kcal": 500, "eaten_minutes": 1140 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1800, "covered": 3, "count": 3, "difference": -600, "may_be_incomplete": false, "reasons": [] } },
    { "id": "long-gap-entries-out-of-order", "input": { "entries": [{ "kcal": 500, "eaten_minutes": 1260 }, { "kcal": 500, "eaten_minutes": 420 }, { "kcal": 500, "eaten_minutes": 720 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1500, "covered": 3, "count": 3, "difference": -900, "may_be_incomplete": true, "reasons": ["long_gap"] } },
    { "id": "gap-just-short-of-the-line", "input": { "entries": [{ "kcal": 500, "eaten_minutes": 420 }, { "kcal": 500, "eaten_minutes": 720 }, { "kcal": 500, "eaten_minutes": 1199 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1500, "covered": 3, "count": 3, "difference": -900, "may_be_incomplete": false, "reasons": [] } },
    { "id": "last-entry-exactly-at-16", "input": { "entries": [{ "kcal": 400, "eaten_minutes": 480 }, { "kcal": 400, "eaten_minutes": 720 }, { "kcal": 400, "eaten_minutes": 960 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1200, "covered": 3, "count": 3, "difference": -1200, "may_be_incomplete": false, "reasons": [] } },
    { "id": "on-target-low-edge", "input": { "entries": [{ "kcal": 700, "eaten_minutes": 480 }, { "kcal": 760, "eaten_minutes": 780 }, { "kcal": 700, "eaten_minutes": 1140 }], "kcal_target": 2400 }, "expected": { "status": "on_target", "eaten": 2160, "covered": 3, "count": 3, "difference": -240, "may_be_incomplete": false, "reasons": [] } },
    { "id": "on-target-high-edge-with-one-entry", "input": { "entries": [{ "kcal": 2640, "eaten_minutes": 1200 }], "kcal_target": 2400 }, "expected": { "status": "on_target", "eaten": 2640, "covered": 1, "count": 1, "difference": 240, "may_be_incomplete": false, "reasons": [] }, "note": "The food logged already reaches the target, so one entry is not a warning." },
    { "id": "over-with-one-entry", "input": { "entries": [{ "kcal": 2641, "eaten_minutes": 780 }], "kcal_target": 2400 }, "expected": { "status": "over", "eaten": 2641, "covered": 1, "count": 1, "difference": 241, "may_be_incomplete": false, "reasons": [] } },
    { "id": "all-kcal-unknown", "input": { "entries": [{ "kcal": null, "eaten_minutes": 480 }, { "kcal": null, "eaten_minutes": 1200 }], "kcal_target": 2400 }, "expected": { "status": "unknown", "eaten": null, "covered": 0, "count": 2, "difference": null, "may_be_incomplete": true, "reasons": ["missing_values", "few_entries", "long_gap"] } },
    { "id": "some-kcal-unknown", "input": { "entries": [{ "kcal": 2200, "eaten_minutes": 480 }, { "kcal": null, "eaten_minutes": 780 }, { "kcal": 100, "eaten_minutes": 1140 }], "kcal_target": 2400 }, "expected": { "status": "on_target", "eaten": 2300, "covered": 2, "count": 3, "difference": -100, "may_be_incomplete": true, "reasons": ["missing_values"] } },
    { "id": "no-target", "input": { "entries": [{ "kcal": 1000, "eaten_minutes": 780 }], "kcal_target": null }, "expected": { "status": "no_target", "eaten": 1000, "covered": 1, "count": 1, "difference": null, "may_be_incomplete": true, "reasons": ["few_entries", "ended_early"] } },
    { "id": "times-not-known", "input": { "entries": [{ "kcal": 1000, "eaten_minutes": null }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 1000, "covered": 1, "count": 1, "difference": -1400, "may_be_incomplete": true, "reasons": ["few_entries"] } },
    { "id": "real-zero-is-a-value", "input": { "entries": [{ "kcal": 0, "eaten_minutes": 1200 }], "kcal_target": 2400 }, "expected": { "status": "under", "eaten": 0, "covered": 1, "count": 1, "difference": -2400, "may_be_incomplete": true, "reasons": ["few_entries"] } }
  ]
}
