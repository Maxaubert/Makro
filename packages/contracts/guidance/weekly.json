            "days": [
              { "local_date": "2026-10-12", "logged": true, "value": 2400, "covered": 1, "count": 1 },
              { "local_date": "2026-10-13", "logged": true, "value": 2400, "covered": 1, "count": 2 }
            ]
          },
          "fibre_g": {
            "average": null, "days_with_value": 0, "covered": 0, "count": 3, "verdict": null,
            "days": [
              { "local_date": "2026-10-12", "logged": true, "value": null, "covered": 0, "count": 1 },
              { "local_date": "2026-10-13", "logged": true, "value": null, "covered": 0, "count": 2 }
            ]
          }
        }
      }
    },
    {
      "id": "real-zero-is-a-value",
      "note": "A known 0 counts as 0. Only null is unknown.",
      "input": {
        "today": "2026-10-14",
        "targets": { "kcal": null, "fibre_g": 30 },
        "days": [
          { "local_date": "2026-10-12", "items": [{ "kcal": 1000, "fibre_g": 0 }] },
          { "local_date": "2026-10-13", "items": [{ "kcal": 2000, "fibre_g": 10 }] }
        ]
      },
      "expected": {
        "dates": ["2026-10-12", "2026-10-13"],
        "counted_days": 2,
        "left_out": [],
        "measures": {
          "kcal": {
            "average": 1500, "days_with_value": 2, "covered": 2, "count": 2, "verdict": null,
            "days": [
              { "local_date": "2026-10-12", "logged": true, "value": 1000, "covered": 1, "count": 1 },
              { "local_date": "2026-10-13", "logged": true, "value": 2000, "covered": 1, "count": 1 }
            ]
          },
          "fibre_g": {
            "average": 5, "days_with_value": 2, "covered": 2, "count": 2, "verdict": "well_under",
            "days": [
              { "local_date": "2026-10-12", "logged": true, "value": 0, "covered": 1, "count": 1 },
              { "local_date": "2026-10-13", "logged": true, "value": 10, "covered": 1, "count": 1 }
            ]
          }
        }
      }
    }
  ]
