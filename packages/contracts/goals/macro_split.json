{
  "version": 1,
  "description": "What each macro's gram target is worth in kcal, and its share of the three together. kcal = grams * 4 for protein and carbs, grams * 9 for fat. share = kcal / (protein kcal + carbs kcal + fat kcal) * 100, rounded half away from zero to a whole percent, each on its own, so the three can add up to 99 or 101. A missing gram target is unknown (null): its kcal is null and no shares exist, because the total is unknown. When the total is 0 there are no shares either. Fibre is not part of the split.",
  "cases": [
    { "id": "lose-on-the-board", "input": { "protein_g": 180, "carbs_g": 260, "fat_g": 71 }, "expected": { "protein_kcal": 720, "carbs_kcal": 1040, "fat_kcal": 639, "protein_share": 30, "carbs_share": 43, "fat_share": 27 } },
    { "id": "maintain-on-the-board", "input": { "protein_g": 180, "carbs_g": 354, "fat_g": 85 }, "expected": { "protein_kcal": 720, "carbs_kcal": 1416, "fat_kcal": 765, "protein_share": 25, "carbs_share": 49, "fat_share": 26 } },
    { "id": "gain-on-the-board", "input": { "protein_g": 180, "carbs_g": 431, "fat_g": 95 }, "expected": { "protein_kcal": 720, "carbs_kcal": 1724, "fat_kcal": 855, "protein_share": 22, "carbs_share": 52, "fat_share": 26 } },
    { "id": "decimal-grams", "input": { "protein_g": 150.5, "carbs_g": 200, "fat_g": 33.3 }, "expected": { "protein_kcal": 602, "carbs_kcal": 800, "fat_kcal": 299.7, "protein_share": 35, "carbs_share": 47, "fat_share": 18 } },
    { "id": "half-rounds-up-and-may-pass-100", "input": { "protein_g": 1, "carbs_g": 7, "fat_g": 0 }, "expected": { "protein_kcal": 4, "carbs_kcal": 28, "fat_kcal": 0, "protein_share": 13, "carbs_share": 88, "fat_share": 0 } },
    { "id": "only-fat", "input": { "protein_g": 0, "carbs_g": 0, "fat_g": 10 }, "expected": { "protein_kcal": 0, "carbs_kcal": 0, "fat_kcal": 90, "protein_share": 0, "carbs_share": 0, "fat_share": 100 } },
    { "id": "all-zero-has-no-shares", "input": { "protein_g": 0, "carbs_g": 0, "fat_g": 0 }, "expected": { "protein_kcal": 0, "carbs_kcal": 0, "fat_kcal": 0, "protein_share": null, "carbs_share": null, "fat_share": null } },
    { "id": "one-unknown-has-no-shares", "input": { "protein_g": 180, "carbs_g": null, "fat_g": 71 }, "expected": { "protein_kcal": 720, "carbs_kcal": null, "fat_kcal": 639, "protein_share": null, "carbs_share": null, "fat_share": null } },
    { "id": "all-unknown", "input": { "protein_g": null, "carbs_g": null, "fat_g": null }, "expected": { "protein_kcal": null, "carbs_kcal": null, "fat_kcal": null, "protein_share": null, "carbs_share": null, "fat_share": null } }
  ]
}
